<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Time: Infinite Game 🕒</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<style>
    body { 
        font-family: 'Fredoka', 'Comic Sans MS', sans-serif; 
        margin: 0; 
        padding: 20px; 
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        min-height: 100vh;
        background-image: url('https://img.freepik.com/premium-photo/cartoon-city-street-metropolis-3d-animation-style-kids_720722-6877.jpg?w=2000');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        overflow-x: hidden;
        cursor: url('data:image/svg+xml;base64,') 2 2, auto;
    }

    /* ВЕРХНЯЯ ПАНЕЛЬ: ЯЗЫКИ И СЛОЖНОСТЬ */
    .top-bar { display: flex; justify-content: space-between; width: 100%; max-width: 900px; margin-bottom: 5px; flex-wrap: wrap; gap: 10px; }
    .toggle-group { display: flex; gap: 10px; background: rgba(0,0,0,0.5); padding: 5px; border-radius: 30px; backdrop-filter: blur(5px); }
    .top-btn { background: transparent; color: white; border: none; padding: 8px 15px; border-radius: 20px; cursor: pointer; font-family: inherit; font-weight: bold; transition: 0.3s; font-size: 16px; }
    .top-btn:hover { background: rgba(255,255,255,0.2); }
    .top-btn.active { background: #ffd700; color: #4a148c; box-shadow: 0 0 10px rgba(255,215,0,0.5); }

    h1 { 
        color: #fff; text-align: center; font-size: 52px;
        text-shadow: 2px 2px 0px #ff66b2, 4px 4px 0px #3498db;
        margin-top: 5px; letter-spacing: 2px;
        background: rgba(0, 0, 0, 0.4); padding: 10px 30px;
        border-radius: 30px; backdrop-filter: blur(5px);
    }

    .level-selector { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; margin-bottom: 25px; max-width: 900px; }

    .lvl-btn { 
        background: linear-gradient(135deg, #3498db, #9b59b6); color: white; border: 2px solid white; 
        padding: 12px 20px; border-radius: 50px; cursor: pointer; font-size: 18px; font-weight: 600;
        transition: all 0.2s; font-family: inherit;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3), inset 0 4px 5px rgba(255, 255, 255, 0.7), inset 0 -6px 8px rgba(0, 0, 0, 0.2); 
        text-shadow: 1px 1px 0 rgba(0,0,0,0.3);
    }
    .lvl-btn:hover { transform: scale(1.1); }
    .lvl-btn:active { transform: scale(0.95); }
    .lvl-btn.active { background: linear-gradient(135deg, #e74c3c, #f39c12); border-color: #ffcc00; animation: pulseLevel 1.5s infinite; }
    @keyframes pulseLevel { 0% { box-shadow: 0 0 10px #ffcc00; } 50% { box-shadow: 0 0 25px #ffcc00; } 100% { box-shadow: 0 0 10px #ffcc00; } }

    .rainbow-border-wrapper {
        background: linear-gradient(45deg, #ff007f, #ff7f00, #ffff00, #00ff00, #0080ff, #8b00ff);
        background-size: 300% 300%; animation: rainbowFrame 4s linear infinite;
        padding: 5px; border-radius: 35px; box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        width: 100%; max-width: 850px; position: relative;
    }
    @keyframes rainbowFrame { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

    .game-container { 
        background: linear-gradient(135deg, #fff0f5, #e6e6fa, #f0f8ff, #f5fffa, #ffffe0, #fffacd); 
        border-radius: 30px; padding: 40px; width: 100%; box-sizing: border-box;
        text-align: center; min-height: 400px; display: flex; flex-direction: column; justify-content: center;
    }

    .question-title { font-size: 26px; color: #fff; background: rgba(0,0,0,0.3); padding: 5px 15px; border-radius: 20px; display: inline-block; margin-bottom: 25px; font-weight: 500;}
    .main-text { font-size: 28px; font-weight: 700; margin-bottom: 15px; color: #4a148c; text-shadow: 1px 1px 0px rgba(255,255,255,0.8); }

    .options-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 25px; }

    .option-btn { 
        background: linear-gradient(180deg, #ffffff, #f0f0f0); border: 2px solid #bdc3c7; 
        padding: 18px; font-size: 20px; border-radius: 20px; cursor: pointer; transition: all 0.2s; 
        font-family: inherit; font-weight: 600; color: #2c3e50; text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15), inset 0 4px 5px rgba(255, 255, 255, 0.8), inset 0 -6px 8px rgba(0, 0, 0, 0.05); 
    }
    .option-btn:hover { transform: scale(1.05); border-color: #3498db; }
    .option-btn.correct { background: linear-gradient(135deg, #2ecc71, #27ae60); color: white; border-color: #27ae60; animation: bounceIn 0.5s; }
    .option-btn.wrong { background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border-color: #c0392b; animation: shake 0.5s; }

    @keyframes bounceIn { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-15px); } 60% { transform: translateY(-7px); } }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); } 20%, 40%, 60%, 80% { transform: translateX(5px); } }

    .action-btn { 
        background: linear-gradient(135deg, #f39c12, #ffcc00); color: white; border: 2px solid #fff; 
        padding: 15px 30px; font-size: 20px; border-radius: 50px; cursor: pointer; margin: 15px auto; 
        transition: all 0.2s; text-transform: uppercase; font-weight: 700; text-shadow: 1px 1px 0 rgba(0,0,0,0.3); display: block;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3), inset 0 4px 5px rgba(255, 255, 255, 0.7), inset 0 -6px 8px rgba(0, 0, 0, 0.2); 
    }
    .action-btn:hover { transform: scale(1.05); }
    .feedback { font-size: 24px; font-weight: 700; margin-top: 20px; min-height: 40px; color: #2c3e50; text-shadow: 1px 1px 0 rgba(255,255,255,0.5);}
    .next-btn { display: none; background: linear-gradient(135deg, #2ecc71, #ffcc00); margin-top: 20px; }

    .confetti { position: absolute; top: -50px; left: 50%; width: 10px; height: 10px; z-index: 50; opacity: 0; pointer-events: none; }
    .confetti-piece { position: absolute; width: 10px; height: 10px; border-radius: 50%; top: 0; left: 0; transition: transform 1s ease-out, opacity 1s ease-out; }

    .digital-clock {
        font-family: 'Share Tech Mono', monospace; font-size: 60px; color: #00ff88; background: #1a1a2e;
        padding: 15px 40px; border-radius: 15px; border: 4px solid #0f3460; display: inline-block;
        margin: 0 auto 20px auto; box-shadow: inset 0 0 20px rgba(0,0,0,0.8), 0 10px 20px rgba(0,0,0,0.3);
        text-shadow: 0 0 15px #00ff88; letter-spacing: 5px;
    }

    .analog-clock {
        width: 200px; height: 200px; border: 10px solid #4a148c; border-radius: 50%; position: relative;
        background: #fff; margin: 0 auto 20px auto; box-shadow: 0 10px 25px rgba(0,0,0,0.3), inset 0 5px 15px rgba(0,0,0,0.1);
    }
    .clock-center { position: absolute; top: 50%; left: 50%; width: 16px; height: 16px; background: #2c3e50; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; }
    .clock-hand { position: absolute; bottom: 50%; left: 50%; transform-origin: bottom; border-radius: 10px; transition: transform 0.5s cubic-bezier(0.4, 2.08, 0.55, 0.44); }
    .hour-hand { width: 8px; height: 60px; background: #e74c3c; margin-left: -4px; z-index: 8; }
    .min-hand { width: 6px; height: 85px; background: #3498db; margin-left: -3px; z-index: 9; }
    
    .clock-number {
        position: absolute; top: 50%; left: 50%; width: 30px; height: 30px; margin: -15px; 
        text-align: center; line-height: 30px; font-weight: 900; font-size: 20px; color: #2c3e50;
    }
    .num1  { transform: rotate(30deg) translateY(-80px) rotate(-30deg); } .num2  { transform: rotate(60deg) translateY(-80px) rotate(-60deg); }
    .num3  { transform: rotate(90deg) translateY(-80px) rotate(-90deg); } .num4  { transform: rotate(120deg) translateY(-80px) rotate(-120deg); }
    .num5  { transform: rotate(150deg) translateY(-80px) rotate(-150deg); } .num6  { transform: rotate(180deg) translateY(-80px) rotate(-180deg); }
    .num7  { transform: rotate(210deg) translateY(-80px) rotate(-210deg); } .num8  { transform: rotate(240deg) translateY(-80px) rotate(-240deg); }
    .num9  { transform: rotate(270deg) translateY(-80px) rotate(-270deg); } .num10 { transform: rotate(300deg) translateY(-80px) rotate(-300deg); }
    .num11 { transform: rotate(330deg) translateY(-80px) rotate(-330deg); } .num12 { transform: rotate(360deg) translateY(-80px) rotate(-360deg); }

    /* СТИЛИ ТЕОРИИ */
    .theory-box { text-align: left; background: rgba(255, 255, 255, 0.7); padding: 25px; border-radius: 20px; font-size: 20px; color: #2c3e50; border: 3px dashed #9b59b6; margin-bottom: 15px; line-height: 1.6; }
    .rule-title { font-size: 24px; color: #4a148c; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
    .highlight { color: #e74c3c; font-weight: bold; background: rgba(231, 76, 60, 0.1); padding: 2px 8px; border-radius: 5px; } 
    .highlight-blue { color: #3498db; font-weight: bold; background: rgba(52, 152, 219, 0.1); padding: 2px 8px; border-radius: 5px; }
    .example-text { color: #7f8c8d; font-style: italic; font-size: 18px; margin-left: 25px; }

    /* СТИЛИ ГЕНЕРАТОРА */
    .clocks-row { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; width: 100%; }
    .clock-card { 
        background: rgba(255,255,255,0.5); padding: 25px; border-radius: 20px; flex: 1; min-width: 300px; 
        box-shadow: inset 0 0 10px rgba(0,0,0,0.05); border: 2px solid rgba(255,255,255,0.8);
        display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    }
    .card-title { color: #4a148c; margin-top: 0; font-size: 24px; border-bottom: 2px dashed #9b59b6; padding-bottom: 10px; width: 100%; text-align: center; }
    .btn-group { display: flex; gap: 10px; width: 100%; margin-top: 15px; }
</style>
</head>
<body onload="init()"> 

<div class="top-bar">
    <div class="toggle-group">
        <button id="diff-easy" class="top-btn" onclick="setDifficulty('easy')">👶 Легкий</button>
        <button id="diff-hard" class="top-btn active" onclick="setDifficulty('hard')">🎓 Обычный</button>
    </div>
    <div class="toggle-group">
        <button id="lang-ru" class="top-btn active" onclick="setLang('ru')">🇷🇺 RU</button>
        <button id="lang-en" class="top-btn" onclick="setLang('en')">🇬🇧 EN</button>
    </div>
</div>

<h1 id="main-title">Time: Infinite Game 🕒</h1>
<div class="level-selector" id="levelSelector">
    <button class="lvl-btn active" onclick="loadMode('theory')" id="btn-theory">📖 Теория</button>
    <button class="lvl-btn" onclick="loadMode('digital')" id="btn-digital">1️⃣ Тест (Электронные)</button>
    <button class="lvl-btn" onclick="loadMode('analog')" id="btn-analog">2️⃣ Тест (Циферблат)</button>
    <button class="lvl-btn" onclick="loadMode('free')" id="btn-free">3️⃣ Генератор 🎲</button>
</div>

<div class="rainbow-border-wrapper">
    <div class="game-container" id="gameContainer">
        <div class="confetti" id="confettiPart"></div>
        <div id="contentBlock"></div>
    </div>
</div>

<script>
    // --- СЛОВАРЬ ЯЗЫКОВ (I18N) ---
    const i18n = {
        ru: {
            title: "Time: Infinite Game 🕒",
            btnTheory: "📖 Теория",
            btnDigital: "1️⃣ Тест (Электронные)",
            btnAnalog: "2️⃣ Тест (Циферблат)",
            btnFree: "3️⃣ Генератор 🎲",
            diffEasy: "👶 Легкий",
            diffHard: "🎓 Обычный",
            theoryTitle: "🧠 Секретные правила времени",
            theory1Title: "🕛 1. Ровно час",
            theory1Text: "В английском языке, когда минутная стрелка стоит ровно на 12 (00 минут), мы всегда говорим волшебное слово <span class='highlight'>o'clock</span>.",
            theory2Title: "🔵 2. Правая половинка (от 1 до 30 минут)",
            theory2Text: "Если прошло немного времени (минутная стрелка на правой стороне), мы используем слово <span class='highlight-blue'>PAST</span> (после). Мы называем минуты, а затем час, <b>после</b> которого они прошли.",
            theory3Title: "🔴 3. Левая половинка (от 31 до 59 минут)",
            theory3Text: "Как только стрелка перевалила за половину, мы начинаем считать, сколько минут <b>осталось</b> до следующего часа! Для этого используется слово <span class='highlight'>TO</span> (до).",
            theory4Title: "✨ 4. Волшебные слова",
            theory4Text: "Англичане не любят говорить '15 минут' или '30 минут'. У них для этого есть специальные слова! <br>🍕 15 минут (кусочек пиццы) = <span class='highlight-blue'>a quarter</span> (четверть)<br>🍕 30 минут (половина пиццы) = <span class='highlight-blue'>half</span> (половина)",
            btnStart: "Всё понятно! Начать игру 🎮",
            genTitle: "Тренировка: Генератор времени 🎲",
            genAny: "Любые минуты",
            genStep: "Шаг 5 минут",
            btnCheck: "👀 Проверить",
            btnNew: "Новое 🔄",
            qTitle: "What time is it?",
            btnNext: "Дальше ➡️",
            feedbackCorrect: "Правильно! Супер! 🎉",
            feedbackWrong: "Ой! Правильно: ",
            winTitle: "Супер-звезда!",
            winText: "Все задания пройдены!",
            btnToAnalog: "Перейти к циферблату ➡️",
            btnToGen: "Перейти к Генератору 🎲"
        },
        en: {
            title: "Time: Infinite Game 🕒",
            btnTheory: "📖 Theory",
            btnDigital: "1️⃣ Test (Digital)",
            btnAnalog: "2️⃣ Test (Analog)",
            btnFree: "3️⃣ Generator 🎲",
            diffEasy: "👶 Easy",
            diffHard: "🎓 Normal",
            theoryTitle: "🧠 The Secret Rules of Time",
            theory1Title: "🕛 1. On the hour",
            theory1Text: "In English, when the minute hand is exactly on 12 (00 minutes), we always use the magic word <span class='highlight'>o'clock</span>.",
            theory2Title: "🔵 2. Right half (1 to 30 minutes)",
            theory2Text: "If a little time has passed (minute hand on the right side), we use the word <span class='highlight-blue'>PAST</span>. We say the minutes, and then the hour they have passed.",
            theory3Title: "🔴 3. Left half (31 to 59 minutes)",
            theory3Text: "Once the hand passes the half, we start counting how many minutes are <b>left</b> until the next hour! We use the word <span class='highlight'>TO</span>.",
            theory4Title: "✨ 4. Magic words",
            theory4Text: "English speakers don't like saying '15 minutes' or '30 minutes'. They have special words! <br>🍕 15 minutes (a slice of pizza) = <span class='highlight-blue'>a quarter</span><br>🍕 30 minutes (half a pizza) = <span class='highlight-blue'>half</span>",
            btnStart: "Got it! Start Game 🎮",
            genTitle: "Practice: Random Time Generator 🎲",
            genAny: "Any minutes",
            genStep: "5-minute step",
            btnCheck: "👀 Check",
            btnNew: "New 🔄",
            qTitle: "What time is it?",
            btnNext: "Next ➡️",
            feedbackCorrect: "Correct! Awesome! 🎉",
            feedbackWrong: "Oops! Correct: ",
            winTitle: "Superstar!",
            winText: "All tasks completed!",
            btnToAnalog: "Go to Analog Clock ➡️",
            btnToGen: "Go to Generator 🎲"
        }
    };

    let currentLang = 'ru'; 
    let currentDifficulty = 'hard'; // 'easy' (0,15,30,45) или 'hard' (как было)

    function setLang(lang) {
        currentLang = lang;
        document.getElementById('lang-ru').classList.toggle('active', lang === 'ru');
        document.getElementById('lang-en').classList.toggle('active', lang === 'en');
        
        const t = i18n[currentLang];
        document.getElementById('main-title').textContent = t.title;
        document.getElementById('btn-theory').textContent = t.btnTheory;
        document.getElementById('btn-digital').textContent = t.btnDigital;
        document.getElementById('btn-analog').textContent = t.btnAnalog;
        document.getElementById('btn-free').textContent = t.btnFree;
        document.getElementById('diff-easy').textContent = t.diffEasy;
        document.getElementById('diff-hard').textContent = t.diffHard;

        if (currentMode === 'theory' || currentMode === 'free') {
            loadMode(currentMode);
        } else {
            renderQuestion();
        }
    }

    function setDifficulty(diff) {
        currentDifficulty = diff;
        document.getElementById('diff-easy').classList.toggle('active', diff === 'easy');
        document.getElementById('diff-hard').classList.toggle('active', diff === 'hard');
        
        // Перезапускаем текущий режим с новой сложностью
        if (currentMode === 'theory') return; // Теорию не нужно обновлять
        if (currentMode === 'free') {
            loadMode('free');
        } else {
            activeQuestions = generateRandomQuestions(currentMode, 10);
            currentQuestionIndex = 0;
            renderQuestion();
        }
    }

    // --- МАШИНА ГЕНЕРАЦИИ ВРЕМЕНИ И АНГЛИЙСКОГО ТЕКСТА ---
    const numberWords = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "a quarter", "sixteen", "seventeen", "eighteen", "nineteen", "twenty", "twenty-one", "twenty-two", "twenty-three", "twenty-four", "twenty-five", "twenty-six", "twenty-seven", "twenty-eight", "twenty-nine", "half"];

    function getHourWord(h) {
        if (h === 0) return "twelve";
        if (h > 12) return numberWords[h - 12];
        return numberWords[h];
    }

    function timeToEnglish(h, m) {
        let currentHour = getHourWord(h);
        let nextHour = getHourWord(h === 12 ? 1 : h + 1);

        if (m === 0) return `It's ${currentHour} o'clock.`;
        if (m === 15) return `It's a quarter past ${currentHour}.`;
        if (m === 30) return `It's half past ${currentHour}.`;
        if (m === 45) return `It's a quarter to ${nextHour}.`;

        if (m < 30) return `It's ${numberWords[m]} past ${currentHour}.`;
        return `It's ${numberWords[60 - m]} to ${nextHour}.`;
    }

    // Умная генерация минут с учетом сложности
    function getRandomMinutes(mode) {
        if (currentDifficulty === 'easy') {
            const easyMins = [0, 15, 30, 45];
            return easyMins[Math.floor(Math.random() * easyMins.length)];
        } else {
            return mode === 'digital' 
                ? Math.floor(Math.random() * 60) 
                : Math.floor(Math.random() * 12) * 5;
        }
    }

    function createQuestionObject(h, m, mode) {
        let correctText = timeToEnglish(h, m);
        let options = [correctText];
        
        // Добавляем логичный неправильный вариант-обманку
        let fakeM1;
        if (m === 0) fakeM1 = 30;
        else if (m === 15) fakeM1 = 45;
        else if (m === 30) fakeM1 = 0;
        else if (m === 45) fakeM1 = 15;
        else fakeM1 = (m > 30) ? 60 - m : 60 - m; 
        
        let fakeOpt1 = timeToEnglish(h, fakeM1);
        if (!options.includes(fakeOpt1)) options.push(fakeOpt1);

        // Добиваем до 3 вариантов
        let attempts = 0;
        while(options.length < 3 && attempts < 20) {
            let fakeH = Math.floor(Math.random() * 12) + 1;
            let fakeM = getRandomMinutes(mode); // Зависит от уровня сложности
            let fakeText = timeToEnglish(fakeH, fakeM);
            if (!options.includes(fakeText)) options.push(fakeText);
            attempts++;
        }

        let timeStr = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`;
        return { time: timeStr, correct: correctText, options: options };
    }

    function generateRandomQuestions(mode, count = 10) {
        let generated = [];
        let requiredMinutes = [15, 30, 45]; 
        
        // Обязательные вопросы
        for (let reqMin of requiredMinutes) {
            let h = Math.floor(Math.random() * 12) + 1;
            generated.push(createQuestionObject(h, reqMin, mode));
        }

        // Остальные случайные
        let remainingCount = count - requiredMinutes.length;
        for(let i=0; i<remainingCount; i++) {
            let h = Math.floor(Math.random() * 12) + 1;
            let m = getRandomMinutes(mode);
            generated.push(createQuestionObject(h, m, mode));
        }
        return generated.sort(() => Math.random() - 0.5);
    }

    let currentMode = 'theory';
    let currentQuestionIndex = 0;
    let activeQuestions = [];
    
    let currentFreeDigitalAnswer = "";
    let currentFreeAnalogAnswer = "";

    function init() {
        for(let i=0; i<30; i++) {
            const part = document.createElement('div');
            part.className = 'confetti-piece';
            part.style.backgroundColor = `hsl(${Math.random()*360}, 100%, 50%)`;
            document.getElementById('confettiPart').appendChild(part);
        }
        setLang('ru'); 
    }

    function loadMode(mode) {
        currentMode = mode;
        const content = document.getElementById('contentBlock');
        const t = i18n[currentLang];
        
        document.getElementById('btn-theory').classList.toggle('active', mode === 'theory');
        document.getElementById('btn-digital').classList.toggle('active', mode === 'digital');
        document.getElementById('btn-analog').classList.toggle('active', mode === 'analog');
        document.getElementById('btn-free').classList.toggle('active', mode === 'free');

        if (mode === 'theory') {
            content.innerHTML = `
                <div class="question-title">${t.theoryTitle}</div>
                <div class="theory-box">
                    <div class="rule-title">${t.theory1Title}</div>
                    ${t.theory1Text}
                    <div class="example-text">👉 05:00 — It's five o'clock.</div>

                    <div class="rule-title">${t.theory2Title}</div>
                    ${t.theory2Text}
                    <div class="example-text">👉 05:14 — It's fourteen past five.</div>

                    <div class="rule-title">${t.theory3Title}</div>
                    ${t.theory3Text}
                    <div class="example-text">👉 05:58 — It's two to six.</div>

                    <div class="rule-title">${t.theory4Title}</div>
                    ${t.theory4Text}
                    <div class="example-text">👉 05:15 — It's a quarter past five.</div>
                    <div class="example-text">👉 05:30 — It's half past five.</div>
                </div>
                <button class="action-btn" onclick="loadMode('digital')">${t.btnStart}</button>
            `;
        } else if (mode === 'free') {
            content.innerHTML = `
                <div class="question-title">${t.genTitle}</div>
                <div class="clocks-row">
                    <div class="clock-card">
                        <h3 class="card-title">${currentDifficulty === 'easy' ? 'Только базовые' : t.genAny}</h3>
                        <div class="digital-clock" id="free-digital-clock" style="margin-top: 10px;">00:00</div>
                        <div class="main-text" id="free-digital-text" style="font-size: 24px; color: #7f8c8d; min-height: 60px; display: flex; align-items: center; text-align: center;">???</div>
                        <div class="btn-group">
                            <button class="action-btn" style="font-size: 16px; padding: 10px; flex: 1; background: linear-gradient(135deg, #9b59b6, #8e44ad);" onclick="revealDigitalAnswer()">${t.btnCheck}</button>
                            <button class="action-btn" style="font-size: 16px; padding: 10px; flex: 1;" onclick="generateDigitalTime()">${t.btnNew}</button>
                        </div>
                    </div>
                    
                    <div class="clock-card">
                        <h3 class="card-title">${currentDifficulty === 'easy' ? 'Только базовые' : t.genStep}</h3>
                        <div class="analog-clock" style="margin-top: 10px;">
                            <div class="clock-number num1">1</div><div class="clock-number num2">2</div>
                            <div class="clock-number num3">3</div><div class="clock-number num4">4</div>
                            <div class="clock-number num5">5</div><div class="clock-number num6">6</div>
                            <div class="clock-number num7">7</div><div class="clock-number num8">8</div>
                            <div class="clock-number num9">9</div><div class="clock-number num10">10</div>
                            <div class="clock-number num11">11</div><div class="clock-number num12">12</div>
                            <div class="clock-center"></div>
                            <div class="clock-hand hour-hand" id="freeHourHand"></div>
                            <div class="clock-hand min-hand" id="freeMinHand"></div>
                        </div>
                        <div class="main-text" id="free-analog-text" style="font-size: 24px; color: #7f8c8d; min-height: 60px; display: flex; align-items: center; text-align: center;">???</div>
                        <div class="btn-group">
                            <button class="action-btn" style="font-size: 16px; padding: 10px; flex: 1; background: linear-gradient(135deg, #9b59b6, #8e44ad);" onclick="revealAnalogAnswer()">${t.btnCheck}</button>
                            <button class="action-btn" style="font-size: 16px; padding: 10px; flex: 1;" onclick="generateAnalogTime()">${t.btnNew}</button>
                        </div>
                    </div>
                </div>
            `;
            setTimeout(() => {
                generateDigitalTime();
                generateAnalogTime();
            }, 50);
        } else {
            if (activeQuestions.length === 0 || currentQuestionIndex >= activeQuestions.length) {
                activeQuestions = generateRandomQuestions(mode, 10);
                currentQuestionIndex = 0;
            }
            renderQuestion();
        }
    }

    function generateDigitalTime() {
        let dh = Math.floor(Math.random() * 12) + 1;
        let dm = getRandomMinutes('digital');
        let dTimeStr = `${dh.toString().padStart(2, '0')}:${dm.toString().padStart(2, '0')}`;
        
        document.getElementById('free-digital-clock').textContent = dTimeStr;
        currentFreeDigitalAnswer = timeToEnglish(dh, dm);
        
        const textElement = document.getElementById('free-digital-text');
        textElement.textContent = "???";
        textElement.style.color = "#7f8c8d";
    }

    function revealDigitalAnswer() {
        const textElement = document.getElementById('free-digital-text');
        textElement.textContent = currentFreeDigitalAnswer;
        textElement.style.color = "#2ecc71";
    }

    function generateAnalogTime() {
        let ah = Math.floor(Math.random() * 12) + 1;
        let am = getRandomMinutes('analog');
        
        currentFreeAnalogAnswer = timeToEnglish(ah, am);
        
        const textElement = document.getElementById('free-analog-text');
        textElement.textContent = "???";
        textElement.style.color = "#7f8c8d";
        
        const minDeg = am * 6;
        const hourDeg = (ah % 12) * 30 + (am * 0.5); 
        document.getElementById('freeHourHand').style.transform = `rotate(${hourDeg}deg)`;
        document.getElementById('freeMinHand').style.transform = `rotate(${minDeg}deg)`;
    }

    function revealAnalogAnswer() {
        const textElement = document.getElementById('free-analog-text');
        textElement.textContent = currentFreeAnalogAnswer;
        textElement.style.color = "#2ecc71";
    }

    function renderQuestion() {
        const content = document.getElementById('contentBlock');
        const q = activeQuestions[currentQuestionIndex];
        const t = i18n[currentLang];
        
        const shuffledOptions = [...q.options].sort(() => Math.random() - 0.5);
        
        let visualElement = currentMode === 'digital' 
            ? `<div class="digital-clock">${q.time}</div>` 
            : `
            <div class="analog-clock">
                <div class="clock-number num1">1</div><div class="clock-number num2">2</div>
                <div class="clock-number num3">3</div><div class="clock-number num4">4</div>
                <div class="clock-number num5">5</div><div class="clock-number num6">6</div>
                <div class="clock-number num7">7</div><div class="clock-number num8">8</div>
                <div class="clock-number num9">9</div><div class="clock-number num10">10</div>
                <div class="clock-number num11">11</div><div class="clock-number num12">12</div>
                <div class="clock-center"></div>
                <div class="clock-hand hour-hand" id="hourHand"></div>
                <div class="clock-hand min-hand" id="minHand"></div>
            </div>`;

        content.innerHTML = `
            <div class="question-title">${t.qTitle} (${currentQuestionIndex + 1}/${activeQuestions.length})</div>
            ${visualElement}
            <div class="options-grid" id="optionsGrid"></div>
            <div class="feedback" id="feedbackMsg"></div>
            <button class="action-btn next-btn" id="nextBtn" onclick="nextQuestion()">${t.btnNext}</button>
        `;

        if (currentMode === 'analog') setClockHands(q.time);

        const grid = document.getElementById('optionsGrid');
        shuffledOptions.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.textContent = opt;
            btn.onclick = () => checkAnswer(btn, opt, q.correct);
            grid.appendChild(btn);
        });
    }

    function setClockHands(timeStr) {
        const [h, m] = timeStr.split(':').map(Number);
        const minDeg = m * 6;
        const hourDeg = (h % 12) * 30 + (m * 0.5); 
        setTimeout(() => {
            document.getElementById('hourHand').style.transform = `rotate(${hourDeg}deg)`;
            document.getElementById('minHand').style.transform = `rotate(${minDeg}deg)`;
        }, 50);
    }

    function checkAnswer(btn, selected, correct) {
        document.querySelectorAll('.option-btn').forEach(b => b.disabled = true);
        const feedback = document.getElementById('feedbackMsg');
        const t = i18n[currentLang];
        
        if (selected === correct) {
            btn.classList.add('correct');
            feedback.style.color = '#2ecc71'; feedback.textContent = t.feedbackCorrect;
            triggerConfetti(); 
        } else {
            btn.classList.add('wrong');
            feedback.style.color = '#e74c3c'; feedback.textContent = t.feedbackWrong + correct;
            document.querySelectorAll('.option-btn').forEach(b => {
                if(b.textContent === correct) b.classList.add('correct');
            });
        }
        document.getElementById('nextBtn').style.display = 'block';
    }

    function nextQuestion() {
        currentQuestionIndex++;
        const t = i18n[currentLang];

        if (currentQuestionIndex < activeQuestions.length) {
            renderQuestion();
        } else {
            triggerConfetti();
            let nextAction = currentMode === 'digital' 
                ? `<button class="action-btn" style="margin-top: 30px;" onclick="loadMode('analog')">${t.btnToAnalog}</button>`
                : `<button class="action-btn" style="margin-top: 30px;" onclick="loadMode('free')">${t.btnToGen}</button>`;

            activeQuestions = [];

            document.getElementById('contentBlock').innerHTML = `
                <div><span style="font-size: 100px;">🏆🌈⭐</span></div>
                <div class="main-text" style="color:#2ecc71;">${t.winTitle}</div>
                <div class="main-text" style="font-size: 24px; color:#4a148c;">${t.winText}</div>
                ${nextAction}
            `;
        }
    }

    function triggerConfetti() {
        const confetti = document.getElementById('confettiPart');
        confetti.style.opacity = 1; confetti.style.transform = 'translate(-50%, -100px) scale(1.5)';
        const pieces = confetti.querySelectorAll('.confetti-piece');
        pieces.forEach(piece => {
            const angle = Math.random() * Math.PI * 2;
            const velocity = 50 + Math.random() * 50;
            const x = Math.cos(angle) * velocity; const y = Math.sin(angle) * velocity - 30; 
            piece.style.transform = `translate(${x}px, ${y}px) rotate(${Math.random()*360}deg)`;
            piece.style.opacity = 0; piece.style.transition = 'transform 1s ease-out, opacity 1s ease-out';
        });
        setTimeout(() => {
            confetti.style.opacity = 0; confetti.style.transform = 'translate(-50%, -50px) scale(1)';
            pieces.forEach(piece => {
                piece.style.transform = 'translate(0,0) rotate(0)'; piece.style.opacity = 1; piece.style.transition = 'none'; 
            });
        }, 1000);
    }
</script>
</body>
</html>
